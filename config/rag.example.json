{
  "manifest": "../runtime/crawler-batches/REPLACE_WITH_BATCH_ID/manifest.json",
  "artifacts": "../runtime/crawler-artifacts",
  "provenance": "../runtime/crawler-provenance",
  "registry": "../runtime/reviewed-source-registry.json",
  "approvals": "../runtime/reviewed-indexing-approvals.json",
  "chunking": {
    "strategy": "recursive-blocks",
    "max_tokens": 384,
    "overlap": 48,
    "token_metric": "utf8-bytes-v1",
    "version": "recursive-blocks-1"
  },
  "bm25": {
    "k1": 1.5,
    "b": 0.75
  },
  "embedding": {
    "backend": "openrouter",
    "model": "baai/bge-m3",
    "provider": null,
    "batch_size": 16,
    "request_timeout": 30,
    "max_input_bytes": 2048
  },
  "retrieval": {
    "mode": "BM25",
    "top_k": 5
  },
  "rrf_k": 60,
  "candidates": 30,
  "cloud": {
    "max_requests_per_operation": 12,
    "max_input_chars": 16000,
    "max_index_chunks": 128,
    "synthetic_live_opt_in": false,
    "retry_policy": {
      "max_retries": 2,
      "backoff_seconds": 0.5,
      "max_backoff_seconds": 4
    }
  },
  "reranking": {
    "enabled": false,
    "model": "cohere/rerank-v3.5",
    "provider": null,
    "candidates": 30,
    "top_n": 5,
    "fallback_to_hybrid": false,
    "request_timeout": 30,
    "max_input_bytes": 8192
  },
  "generation": {
    "enabled": false,
    "model": "openai/gpt-4o-mini",
    "provider": null,
    "temperature": 0,
    "max_tokens": 512,
    "max_evidence": 5,
    "request_timeout": 30,
    "max_input_bytes": 16000
  }
}
